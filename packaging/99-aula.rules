# Linux: allow non-root access to AULA keyboard HID interfaces.
#
# Install:
#   sudo cp packaging/99-aula.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Without this, opening the vendor HID collection needs root.

# AULA F75 (Sinowealth) — wired USB-C mode
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", MODE="0660", TAG+="uaccess"

# AULA 2.4 GHz receiver (Compx) — the wireless link
#
# A receiver is a separate USB device under its own chipset's VID/PID, not the
# keyboard's. This one is confirmed; another production run may ship a different
# id, in which case find yours with:
#
#     cargo run --example smoke -- scan --deep
#
# and add it alongside. Do NOT replace these with a blanket
# `SUBSYSTEM=="hidraw", MODE="0660"` rule: that would hand every HID device on
# the machine to unprivileged users.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", MODE="0660", TAG+="uaccess"
